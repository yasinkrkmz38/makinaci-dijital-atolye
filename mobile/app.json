{
  "expo": {
    "name": "Dijital Makinacı",
    "slug": "dijital-makinaci",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/branding/icon-legacy.png",
    "scheme": "dijitalmakinaci",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.dijitalmakinaci.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Dijital Makinacı hesabınıza güvenli ve isteğe bağlı giriş için Face ID kullanılır.",
        "NSCameraUsageDescription": "Makine QR kodlarını taramak ve bakım kayıtlarına fotoğraf eklemek için kamera kullanılır.",
        "NSPhotoLibraryUsageDescription": "Bakım, arıza ve iş emri kayıtlarına fotoğraf eklemek için galeri kullanılır."
      }
    },
    "android": {
      "package": "pro.dijitalmakinaci.app",
      "versionCode": 4,
      "icon": "./assets/branding/icon-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/icon-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/icon-monochrome.png",
        "backgroundColor": "#081722"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dijitalmakinaci.pro",
              "pathPrefix": "/app"
            },
            {
              "scheme": "dijitalmakinaci"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Makine QR kodlarını taramak ve saha kayıtlarına fotoğraf eklemek için kameraya izin verin."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Saha kayıtlarına fotoğraf eklemek için galeri erişimine izin verin."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/icon-monochrome.png",
          "color": "#2D6CDF"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dijital Makinacı hesabınıza güvenli giriş için Face ID kullanın."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081722",
          "image": "./assets/branding/icon-adaptive-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://dijitalmakinaci.pro",
      "eas": {
        "projectId": "75eedfb8-b714-430e-8510-41ea33e55718"
      },
      "router": {}
    },
    "owner": "ykorkmaz38"
  }
}
